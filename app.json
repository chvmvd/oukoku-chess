{
  "expo": {
    "name": "おうこくチェス",
    "slug": "oukoku-chess",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "icon": "./assets/images/icon.png",
    "scheme": "oukokuchess",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFCF5",
    "ios": {
      "bundleIdentifier": "com.chvmvd.oukokuchess"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDE6E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.chvmvd.oukokuchess"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFCF5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31a6dcdf-09c0-417f-8d3d-268eb398b35b"
      }
    }
  }
}
